# Vite 환경변수 규칙
# - VITE_* : 클라이언트 번들에 포함됨. 시크릿 금지.
# - 그 외   : 빌드 도구에서만 참조 가능.

# ========================
# 백엔드 API (관리자 전용 엔드포인트)
# ========================
VITE_API_URL=http://localhost:8000
VITE_API_ADMIN_PREFIX=/admin

# ========================
# 모니터링
# ========================
VITE_SENTRY_DSN=
