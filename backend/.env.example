# ========================
# 환경
# ========================
ENV=development                          # development | production
DEBUG=true

# ========================
# 데이터베이스 (PostgreSQL + asyncpg)
# ========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dweb
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dweb_test

# ========================
# JWT
# ========================
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# 비밀번호 해싱 (B1 - 비번 pre-hash pepper. JWT_SECRET와 별개 키)
# 생성 예: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# pre-hash 방식이라 변경 시 전 유저 비번 재설정 필요 (로테이션 불가)
# ========================
PASSWORD_PEPPER=change-me-to-a-long-random-string

# ========================
# 토큰 해싱 (B2 - refresh/이메일 인증 토큰 post-hash pepper. PASSWORD_PEPPER와 별개 키)
# 생성 예: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# post-hash 방식이라 교체 시 재-HMAC으로 무중단 로테이션 가능
# ========================
TOKEN_PEPPER=change-me-to-a-long-random-string

# ========================
# 앱 URL (CORS, OAuth 콜백 등은 config.py에서 이 값으로 조립)
# ========================
APP_BASE_URL=http://localhost:4321      # 독자 사이트
ADMIN_BASE_URL=http://localhost:5173    # 관리자 사이트
API_BASE_URL=http://localhost:8000      # 백엔드 공개 주소

# ========================
# OAuth - 카카오 (REDIRECT_URI는 config.py에서 API_BASE_URL 기반으로 조립)
# ========================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ========================
# OAuth - 구글 (REDIRECT_URI는 config.py에서 API_BASE_URL 기반으로 조립)
# 구글 콘솔 '승인된 리디렉션 URI'에 {API_BASE_URL}/auth/callback/google 을 정확히 등록 (dev/prod 양쪽)
# ========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================
# 결제 - 포트원 V2
# ========================
# 관리자콘솔 → 결제연동 → 연동 관리 → 식별코드·API Keys → V2 API
PORTONE_V2_API_SECRET=

# 관리자콘솔 → 결제연동 → 연동 관리 → 스토어 아이디
PORTONE_STORE_ID=

# 웹훅 검증용 시크릿 (관리자콘솔 → 결제연동 → 웹훅 설정에서 발급)
PORTONE_WEBHOOK_SECRET=

# 채널 키: 결제 수단별로 채널 추가 후 발급 (프론트에서도 사용)
# 관리자콘솔 → 결제연동 → 채널 관리에서 확인
PORTONE_CHANNEL_KEY_CARD=              # 카드 채널 키
PORTONE_CHANNEL_KEY_KAKAOPAY=          # 카카오페이 채널 키
PORTONE_CHANNEL_KEY_TOSSPAY=           # 토스페이 채널 키

# ========================
# 스토리지 - Cloudflare R2 (S3 호환)
# 대시보드 → R2 → Account Details의 계정 ID / API Tokens → Manage에서 토큰 발급
# (권한 Object Read & Write. dweb·dweb-cover 두 버킷을 모두 커버해야 함 - 토큰 발급 시
# 버킷을 하나만 선택했다면 두 버킷 다 선택하거나 계정 전체 권한으로 재발급)
# Secret은 생성 화면에서 1회만 표시
# ========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dweb
# 표지·회차 썸네일 공개 축소본 전용 버킷(M2 D1). dweb과 절대 같은 값으로 두지 말 것 -
# 공개 설정은 버킷 단위라 원고까지 서명 없이 노출된다(DECISIONS "표지 서빙").
R2_PUBLIC_BUCKET=dweb-cover
# ⚠️ 대시보드 '버킷 Settings > S3 API' 주소 끝의 /버킷명은 빼고 넣을 것 (붙이면 키 오염)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=300

# dweb-cover의 공개 접근 주소. 미설정이면 표지·썸네일 URL이 None으로 내려가 프론트가
# placeholder로 처리한다(부팅은 항상 가능). 운영 = 커스텀 도메인(Cloudflare 계정에 zone
# 등록 필요). dev = R2 대시보드에서 "Public Development URL"을 켜면 나오는 r2.dev 주소로
# 즉시 대체 가능 - 단, r2.dev는 Cloudflare 공식 문서상 rate-limited & 운영 비권장이라
# 운영 도메인 연결 후엔 반드시 커스텀 도메인으로 교체할 것.
PUBLIC_ASSET_BASE_URL=https://cover.example.com

# ========================
# 이메일 발송 (Resend - M1 E1)
# RESEND_API_KEY: Resend 대시보드 → API Keys에서 발급
# ⚠️ dev 기본값 onboarding@resend.dev는 Resend 테스트 모드
#    → 본인 Resend 계정 이메일 주소로만 발송됨 (임의 주소는 거부)
#    → dev DoD(수신함 도착)는 반드시 본인 메일로 가입해 확인할 것
# DKIM 인증된 커스텀 도메인 확보 후 EMAIL_FROM을 noreply@<도메인>으로 교체
# ========================
RESEND_API_KEY=
EMAIL_FROM=dweb <onboarding@resend.dev>

# ========================
# 모니터링
# ========================
SENTRY_DSN=

# ========================
# 2FA / TOTP (관리자용 - DECISIONS.md "보안 결정" 참조)
# ========================
TOTP_ISSUER=dweb-admin
# TOTP 시크릿 Fernet 암호화 키. 반드시 유효한 Fernet 키(32B url-safe base64).
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 아래는 예시 키 - 개발/운영 각자 새로 생성해 교체할 것(커밋된 예시 키를 그대로 쓰지 말 것).
TOTP_ENCRYPTION_KEY=n4E8aqTzzTTl53S__1IYPOyCaqZvSbVg2LQ3VOMZqEs=
