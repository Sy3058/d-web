COMPOSE_PROJECT_NAME=dweb-staging
IMAGE_PREFIX=ghcr.io/your-owner/your-repo/staging
DEPLOY_SHA=0123456789abcdef0123456789abcdef01234567
BACKEND_ENV_FILE=/home/your-user/d-web-deploy/staging/backend.env
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
APP_HOST=staging.example.com
ADMIN_HOST=staging-admin.example.com
API_HOST=staging-api.example.com
PAYMENT_ENVIRONMENT=test
PAYMENTS_ACCEPT_NEW=false
EDGE_NETWORK=dweb-staging-edge
EDGE_ALIAS_PREFIX=staging
