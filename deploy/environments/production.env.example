COMPOSE_PROJECT_NAME=dweb-production
IMAGE_PREFIX=ghcr.io/your-owner/your-repo/production
DEPLOY_SHA=0123456789abcdef0123456789abcdef01234567
BACKEND_ENV_FILE=/home/your-user/d-web-deploy/production/backend.env
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
APP_HOST=example.com
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
# M7 전환 검증과 별도 승인 뒤에만 live로 직접 바꾼다. 배포 자동화가 이 값을 바꾸지 않는다.
PAYMENT_ENVIRONMENT=test
PAYMENTS_ACCEPT_NEW=false
EDGE_NETWORK=dweb-production-edge
EDGE_ALIAS_PREFIX=production
