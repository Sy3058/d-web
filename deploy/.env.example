# Copy outside the repository to ~/d-web-deploy/deploy.env. Do not commit populated values.
RELEASE_SHA=
IMAGE_PREFIX=dweb-staging

# Use bare hostnames only, without a scheme, port, path, or trailing slash.
APP_HOST=staging.example.com
ADMIN_HOST=staging-admin.example.com
API_HOST=staging-api.example.com
ACME_EMAIL=admin@example.com

# Must be an absolute path on the deployment host.
BACKEND_ENV_FILE=/home/your-user/d-web-deploy/backend.env

# Required. Use a long random hexadecimal value so it can be inserted safely in DATABASE_URL.
POSTGRES_PASSWORD=

# Keep false until every PortOne test setting has been configured and verified.
PAYMENTS_ACCEPT_NEW=false
