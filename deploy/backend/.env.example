# Copy this file outside the repository to the absolute BACKEND_ENV_FILE path.
# Compose owns ENV, DEBUG, DATABASE_URL, public base URLs, and payment mode switches.

# Required secrets. Generate independent values for every field.
JWT_SECRET=
PASSWORD_PEPPER=
TOKEN_PEPPER=
TOTP_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_ABSOLUTE_MAX_DAYS=30
TOTP_ISSUER=dweb-admin
TOTP_TRUSTED_DEVICE_DAYS=30

# Optional OAuth providers.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PortOne test credentials. Required only when PAYMENTS_ACCEPT_NEW=true.
PORTONE_V2_API_SECRET=
PORTONE_STORE_ID=
PORTONE_WEBHOOK_SECRET=
PORTONE_CHANNEL_KEY_CARD=
PORTONE_CHANNEL_KEY_KAKAOPAY=
PORTONE_CHANNEL_KEY_TOSSPAY=

# Optional Cloudflare R2 storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dweb
R2_PUBLIC_BUCKET=dweb-cover
R2_ENDPOINT=
R2_SIGNED_URL_TTL_SECONDS=300
PUBLIC_ASSET_BASE_URL=https://cover.example.com

# Optional Resend mail and Sentry monitoring.
RESEND_API_KEY=
EMAIL_FROM=dweb <noreply@example.com>
SENTRY_DSN=
