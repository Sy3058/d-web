# Astro 환경변수 규칙
# - PUBLIC_* : 클라이언트(브라우저) 노출됨. SDK 공개 키만.
# - 그 외     : SSR/빌드 타임에만 사용. SECRET_* 는 절대 .astro 컴포넌트에서 참조 X
#               (HTML에 인라인되어 노출됨 - root CLAUDE.md 참조)

# ========================
# 백엔드 API
# ========================
PUBLIC_API_URL=http://localhost:8000
# Astro SSR Node에서만 사용. 로컬은 생략 가능하고 compose는 http://api:8000을 주입한다.
API_INTERNAL_URL=http://localhost:8000

# ========================
# OAuth - 클라이언트 ID는 공개 OK (시크릿은 백엔드)
# ========================
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_KAKAO_CLIENT_ID=

# ========================
# 모니터링 - Sentry 프론트엔드 DSN (공개)
# ========================
PUBLIC_SENTRY_DSN=
