---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverImage from '../../components/works/CoverImage.astro';
import EpisodeRow from '../../components/works/EpisodeRow.astro';
import WorkProgress from '../../components/works/WorkProgress';
import Badge from '../../components/ui/Badge.astro';
import Chip from '../../components/ui/Chip.astro';
import {
  getWorkDetail,
  statusLabel,
  buildWorksUrl,
  parseOrder,
  orderEpisodes,
  type WorkDetail,
} from '../../lib/catalog';
import { applyCatalogCache } from '../../lib/http';

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let work: WorkDetail | null = null;
let loadError = false;

try {
  work = await getWorkDetail(id);
} catch {
  // 5xx 등 알 수 없는 에러 - "작품 없음"(정상 404)으로 오분류하지 않는다(fail-closed,
  // lib/catalog.ts getWorkDetail 참조).
  loadError = true;
}

// 404(작품 없음)도 no-store - 예약 공개 전 404가 캐시되면 공개 후에도 계속 404를 본다
// (백엔드 works.py의 같은 이유). 정책은 lib/http.ts applyCatalogCache에 집약.
applyCatalogCache(Astro.response, { error: loadError, notFound: !work });

// 정렬 토글(E3). 서버는 항상 sort_order 오름차순(작가 지정 순서)으로 준다 - "첫 화
// 보기"는 이 원본 배열의 [0]을 써야 정렬 토글과 무관하게 항상 같은 회차를 가리킨다.
// 뒤집힌 배열에서 [0]을 뽑으면 desc일 때 마지막 화가 "첫 화"로 둔갑한다.
const order = parseOrder(Astro.url.searchParams.get('order'));
const displayEpisodes = work ? orderEpisodes(work.episodes, order) : [];
const freeCount = work ? work.episodes.filter((ep) => ep.is_free).length : 0;
---

<BaseLayout
  title={work ? work.title : '작품을 찾을 수 없어요'}
  canonicalPath={Astro.url.pathname}
  reserveFloatingCtaSpace={Boolean(work?.episodes.length)}
>
  <div class="max-w-[1140px] mx-auto px-6 py-12">
    {
      loadError ? (
        <p class="text-sm text-muted">일시적인 오류로 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
      ) : !work ? (
        <p class="text-sm text-muted">작품을 찾을 수 없어요.</p>
      ) : (
        <>
          <div class="flex flex-col sm:flex-row gap-8 mb-12">
            <div class="w-full sm:w-64 shrink-0">
              <CoverImage src={work.cover_image_url} alt={work.title} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h1 class="text-headline-lg text-ink">{work.title}</h1>
                <Badge variant="neutral">{statusLabel(work.status)}</Badge>
              </div>
              {work.synopsis && <p class="text-body-md text-ink whitespace-pre-line mb-4">{work.synopsis}</p>}
              {work.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {work.tags.map((tag) => (
                    <Chip href={buildWorksUrl({ tag: tag.name })}>{tag.name}</Chip>
                  ))}
                </div>
              )}
            </div>
          </div>

          {work.episodes.length === 0 ? (
            <p class="text-sm text-muted">아직 등록된 회차가 없어요.</p>
          ) : (
            <div>
              <WorkProgress
                workId={work.id}
                episodes={work.episodes.map((episode) => ({
                  id: episode.id,
                  publicId: episode.public_id,
                  title: episode.title,
                }))}
                client:idle
              />
              <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-3">
                  <span class="text-sm text-muted">
                    총 {work.episodes.length}화 · 무료 {freeCount}화
                  </span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                  <a
                    href={Astro.url.pathname}
                    class:list={[order === 'desc' ? 'text-ink font-medium' : 'text-muted']}
                  >
                    최신순
                  </a>
                  <span class="text-muted">·</span>
                  <a
                    href={`${Astro.url.pathname}?order=asc`}
                    class:list={[order === 'asc' ? 'text-ink font-medium' : 'text-muted']}
                  >
                    오래된순
                  </a>
                </div>
              </div>
              {displayEpisodes.map((episode, i) => (
                <EpisodeRow workId={work!.id} episode={episode} first={i === 0} />
              ))}
            </div>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
