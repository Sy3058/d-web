---
// ?page=/?tag=를 서버에서 읽어야 해서 SSR 강제(GUIDE_ASTRO 델타 4, M2 결정 3).
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilterBar from '../../components/works/TagFilterBar.astro';
import WorkCard from '../../components/works/WorkCard.astro';
import Pagination from '../../components/works/Pagination.astro';
import {
  getWorks,
  getTags,
  totalPages as calcTotalPages,
  buildWorksUrl,
  type WorkListResponse,
  type PublicTag,
} from '../../lib/catalog';
import { applyCatalogCache } from '../../lib/http';

// isSafeInteger로 거른다: isInteger(1e21)는 true라 통과하지만 String(1e21)='1e+21'가
// 백엔드 int 파싱에서 422를 내 fallback이 안 먹는다. 1e21은 safe integer가 아니라 여기서 걸린다.
const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isSafeInteger(pageParam) && pageParam > 0 ? pageParam : 1;
const tag = Astro.url.searchParams.get('tag') ?? undefined;

let works: WorkListResponse = { items: [], total: 0, page, size: 0 };
let tags: PublicTag[] = [];
let loadError = false;

// 작품 목록과 태그를 독립 처리(allSettled) - 보조 UI인 태그 필터의 실패가 핵심 카탈로그
// 전체를 무너뜨리지 않게 한다. 작품 로드 실패만 fail-closed 에러로 승격, 태그 실패는 빈 배열.
const [worksResult, tagsResult] = await Promise.allSettled([getWorks(page, tag), getTags()]);
if (worksResult.status === 'fulfilled') {
  works = worksResult.value;
} else {
  loadError = true;
}
tags = tagsResult.status === 'fulfilled' ? tagsResult.value : [];

// 범위 밖 페이지(?page=9999)는 마지막 페이지로 정규화 - 안 하면 "빈 카탈로그" 거짓 안내 +
// "9999 / 2" 깨진 페이저가 나온다. 리다이렉트라 캐시 헤더 설정보다 먼저 return.
if (!loadError && works.total > 0) {
  const lastPage = calcTotalPages(works.total, works.size);
  if (page > lastPage) {
    return Astro.redirect(buildWorksUrl({ page: lastPage, tag }), 302);
  }
}

applyCatalogCache(Astro.response, { error: loadError });
---

<BaseLayout title="작품">
  <div class="max-w-[1140px] mx-auto px-6 py-12">
    <h1 class="text-headline-lg text-ink mb-8">작품</h1>

    {
      loadError ? (
        <p class="text-sm text-muted">일시적인 오류로 목록을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
      ) : (
        <>
          <TagFilterBar tags={tags} activeTag={tag} />

          {works.items.length === 0 ? (
            <p class="mt-16 text-sm text-muted text-center">
              {tag ? '해당 태그의 작품이 없어요.' : '아직 등록된 작품이 없어요.'}
            </p>
          ) : (
            <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
              {works.items.map((work) => (
                <WorkCard work={work} />
              ))}
            </div>
          )}

          <div class="mt-12">
            <Pagination page={works.page} totalPages={calcTotalPages(works.total, works.size)} tag={tag} />
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
