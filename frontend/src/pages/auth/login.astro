---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/auth/LoginForm';
import GoogleButton from '../../components/auth/GoogleButton.astro';

const ERROR_MESSAGES: Record<string, string> = {
  oauth_failed: '구글 로그인에 실패했어요. 다시 시도해 주세요.',
  email_exists: '이미 이메일로 가입된 계정이에요. 비밀번호로 로그인해 주세요.',
};

const errorParam = Astro.url.searchParams.get('error');
const oauthError = errorParam ? (ERROR_MESSAGES[errorParam] ?? null) : null;
---

<BaseLayout title="로그인">
  <div class="bg-canvas py-16 px-5">
    <div class="w-full mx-auto sm:max-w-[400px] sm:rounded-control sm:border sm:border-line sm:bg-paper sm:px-8 sm:py-10">
      {oauthError && (
        <div class="rounded-control border border-line px-4 py-3 text-sm text-ink mb-6">
          {oauthError}
        </div>
      )}
      <h1 class="text-xl font-semibold tracking-tight text-ink mb-6">로그인</h1>
      <LoginForm client:load />
      <div class="my-6 flex items-center gap-3">
        <div class="flex-1 border-t border-line"></div>
        <span class="text-xs text-muted">또는</span>
        <div class="flex-1 border-t border-line"></div>
      </div>
      <GoogleButton />
      <p class="mt-8 text-sm text-muted text-center">
        계정이 없나요?{' '}
        <a href="/auth/signup" class="text-ink underline underline-offset-4">회원가입</a>
      </p>
    </div>
  </div>
</BaseLayout>
