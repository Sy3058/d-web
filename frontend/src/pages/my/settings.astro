---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMeOnServer } from '@/lib/auth.server';
import type { User } from '@/lib/auth';
import AccountSessionRecovery, { AccountSettings } from '@/components/account/AccountSessionRecovery';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');

let user: User | null = null;
let loadError = false;
try {
  user = await getMeOnServer(Astro.request.headers.get('cookie') ?? undefined);
} catch {
  loadError = true;
}
---

<BaseLayout title="설정">
  <div class="max-w-[720px] mx-auto px-6 py-16 text-ink">
    <h1 class="text-2xl font-semibold tracking-tight mb-8">설정</h1>
    <section class="rounded-control border border-line p-6">
      {loadError ? (
        <p class="text-sm text-muted">일시적인 오류로 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
      ) : user ? (
        <AccountSettings />
      ) : (
        <AccountSessionRecovery page="settings" client:load />
      )}
    </section>
  </div>
</BaseLayout>
