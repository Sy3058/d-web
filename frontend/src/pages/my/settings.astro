---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMe } from '../../lib/auth';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');

let loadError = false;
try {
  const user = await getMe(Astro.request.headers.get('cookie') ?? undefined);
  if (!user) return Astro.redirect('/auth/login');
} catch {
  loadError = true;
}
---

<BaseLayout title="설정">
  <div class="max-w-[720px] mx-auto px-6 py-16 text-ink">
    <h1 class="text-2xl font-semibold tracking-tight mb-8">설정</h1>
    <section class="rounded-control border border-line p-6">
      {loadError ? (
        <p class="text-sm text-muted">일시적인 오류로 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
      ) : (
        <>
          <h2 class="text-sm font-medium mb-2">알림 설정</h2>
          <p class="text-sm text-muted">알림 설정 기능은 준비 중이에요.</p>
        </>
      )}
    </section>
  </div>
</BaseLayout>
