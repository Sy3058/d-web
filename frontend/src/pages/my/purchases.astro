---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PurchaseHistory from '../../components/purchases/PurchaseHistory';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<BaseLayout title="구매 내역">
  <div class="max-w-[720px] mx-auto px-6 py-16 text-ink">
    <h1 class="text-2xl font-semibold tracking-tight mb-8">구매 내역</h1>
    <PurchaseHistory client:load />
  </div>
</BaseLayout>
