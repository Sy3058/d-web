---
export const prerender = false;
import PageLayout from '@/layouts/PageLayout.astro';
import { getMeOnServer } from '@/lib/auth.server';
import type { User } from '@/lib/auth';
import ProfileEditor from '@/components/account/ProfileEditor';
import AccountSessionRecovery from '@/components/account/AccountSessionRecovery';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');

const cookie = Astro.request.headers.get('cookie') ?? undefined;

let user: User | null = null;
let loadError = false;
try {
  user = await getMeOnServer(cookie);
} catch {
  loadError = true;
}
---

<PageLayout title="프로필 수정">
  {loadError ? (
    <p class="text-sm text-muted">일시적인 오류로 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
  ) : user ? (
    <ProfileEditor initialUser={user} client:load />
  ) : (
    <AccountSessionRecovery page="profile" client:load />
  )}
</PageLayout>
