---
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // 정렬(?order=)처럼 캐시 키 정규화를 위해 URL에서 생략하는 기본값 쿼리가 있는
  // 페이지용 - 같은 콘텐츠가 쿼리 유무로 두 URL에 중복 색인되는 걸 막는다(E3).
  // 쿼리 없는 pathname만 넘긴다(예: Astro.url.pathname).
  canonicalPath?: string;
  // 하단 fixed CTA가 있는 페이지에서 Footer 뒤에 실제 문서 최하단 예약 공간을 만든다.
  reserveFloatingCtaSpace?: boolean;
  // 정상 뷰어는 읽기 전용 상하단 컨트롤이 전역 Navbar·Footer를 대신한다.
  hideGlobalChrome?: boolean;
}

const {
  title,
  description = '',
  canonicalPath,
  reserveFloatingCtaSpace = false,
  hideGlobalChrome = false,
} = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {canonicalPath && <link rel="canonical" href={new URL(canonicalPath, Astro.url).href} />}
    <title>{title} · 도군</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    {!hideGlobalChrome && <Navbar />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideGlobalChrome && <Footer />}
    {
      reserveFloatingCtaSpace && (
        <div
          aria-hidden="true"
          data-floating-cta-space
          style="height: calc(5rem + env(safe-area-inset-bottom));"
        />
      )
    }
  </body>
</html>
