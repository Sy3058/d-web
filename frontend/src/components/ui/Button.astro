---
import { controlBase, ghostControl } from './controlStyles';

// 버튼형 요소 (DESIGN.md Buttons). 탐색은 링크, 동작은 버튼으로 렌더한다.
// 비활성 링크에는 href와 포커스 진입점을 주지 않는다.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
}

const { variant = 'primary', href, type = 'button', disabled = false, class: className } = Astro.props;

const variants = {
  primary: `${controlBase} bg-ink-strong text-paper px-4 py-2.5 hover:bg-ink disabled:hover:bg-ink-strong aria-disabled:hover:bg-ink-strong`,
  secondary: `${controlBase} border border-ink text-ink px-4 py-2.5 hover:bg-hover disabled:hover:bg-transparent aria-disabled:hover:bg-transparent`,
  ghost: ghostControl,
};
---

{
  href && disabled ? (
    <span aria-disabled="true" class:list={[variants[variant], className]}>
      <slot />
    </span>
  ) : href ? (
    <a href={href} class:list={[variants[variant], className]}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class:list={[variants[variant], className]}>
      <slot />
    </button>
  )
}
