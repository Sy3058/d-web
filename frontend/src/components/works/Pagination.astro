---
import Button from '@/components/ui/Button.astro';
import { paginationList, paginationCurrent } from '@/components/ui/controlStyles';
import { buildWorksUrl } from '@/lib/catalog';

interface Props {
  page: number;
  totalPages: number;
  tag?: string;
}

const { page, totalPages, tag } = Astro.props;
const hasPrev = page > 1;
const hasNext = page < totalPages;
---

{
  totalPages > 1 && (
    <nav aria-label="페이지 이동">
      <ul class={paginationList}>
        <li>
          <Button variant="ghost" href={hasPrev ? buildWorksUrl({ page: page - 1, tag }) : undefined} disabled={!hasPrev}>
            <span aria-hidden="true">‹</span> 이전 페이지
          </Button>
        </li>
        <li>
          <span aria-current="page" class={paginationCurrent}>
            <span class="sr-only">현재 </span>{page}<span class="sr-only">페이지, 전체 {totalPages}페이지</span>
          </span>
        </li>
        <li>
          <Button variant="ghost" href={hasNext ? buildWorksUrl({ page: page + 1, tag }) : undefined} disabled={!hasNext}>
            다음 페이지 <span aria-hidden="true">›</span>
          </Button>
        </li>
      </ul>
    </nav>
  )
}
