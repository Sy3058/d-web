---
import CoverImage from './CoverImage.astro';
import Badge from '../ui/Badge.astro';
import Chip from '../ui/Chip.astro';
import { statusLabel, type WorkListItem } from '../../lib/catalog';

interface Props {
  work: WorkListItem;
}

const { work } = Astro.props;
---

<a
  href={`/works/${work.id}`}
  class="group block overflow-hidden rounded-control border border-line bg-paper"
>
  <CoverImage src={work.cover_image_url} alt={work.title} class="rounded-none" />
  <div class="space-y-3 p-3 sm:p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="truncate text-sm font-semibold leading-snug text-ink group-hover:underline sm:text-base">
        {work.title}
      </h3>
      <Badge variant="neutral" class="shrink-0">{statusLabel(work.status)}</Badge>
    </div>
    {
      work.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {work.tags.map((tag) => (
            // href 없음: 이 카드 전체가 이미 <a>라 중첩 앵커를 만들면 안 된다(무효 HTML).
            <Chip>{tag.name}</Chip>
          ))}
        </div>
      )
    }
  </div>
</a>
