#!/bin/sh
# 통합 브랜치로의 직접 push를 거부한다.
#
# GitHub의 브랜치 보호와 별개로 main/develop/release 직접 push를 로컬에서도 차단한다.
# 서버에서 PR 대상과 머지 방식을 강제하려면 GitHub ruleset을 별도로 설정해야 한다.
# 로컬 갱신은 pull(fetch + fast-forward)이라 push가 아니므로 이 훅에 걸리지 않는다.
# (새 클론에서는 'git config core.hooksPath .githooks' 가 설정돼 있어야 이 훅이 동작한다.)

# pre-push는 stdin으로 "<local ref> <local sha> <remote ref> <remote sha>" 줄들을 받는다.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/develop|refs/heads/release)
      printf '%s\n' "push 거부: 통합 브랜치로 직접 push할 수 없습니다: $remote_ref" >&2
      printf '%s\n' "  main/develop/release는 PR로만 갱신하세요." >&2
      exit 1
      ;;
  esac
done

exit 0
