# 로컬 전체 스택 실행 시 라우팅 (docker compose up)
# admin.localhost 는 /etc/hosts 에 "127.0.0.1 admin.localhost" 추가 필요 (Linux/WSL2)
# 스테이징/프로덕션 HTTPS 설정은 D4 (VPS Caddy + Let's Encrypt) 에서 진행

http://localhost {
    reverse_proxy frontend:4321
}

http://admin.localhost {
    reverse_proxy admin:80
}

# API 직접 접근 편의용 (localhost:8000 으로도 접근 가능)
http://api.localhost {
    reverse_proxy api:8000 {
        # 클라이언트가 위조한 XFF를 실제 peer IP로 덮어씀 (append 아님).
        # rate limit(I2) 키가 실제 클라이언트 IP가 되도록 하는 2겹 방어의 한 겹.
        # 나머지 한 겹은 uvicorn --proxy-headers --forwarded-allow-ips (backend/Dockerfile).
        header_up X-Forwarded-For {remote_host}
    }
}
