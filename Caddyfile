# 로컬 전체 스택 실행 시 라우팅 (docker compose up)
# admin.localhost 는 /etc/hosts 에 "127.0.0.1 admin.localhost" 추가 필요 (Linux/WSL2)
# 스테이징/프로덕션 HTTPS 설정은 D4 (VPS Caddy + Let's Encrypt) 에서 진행

http://localhost {
    reverse_proxy frontend:80
}

http://admin.localhost {
    reverse_proxy admin:80
}

# API 직접 접근 편의용 (localhost:8000 으로도 접근 가능)
http://api.localhost {
    reverse_proxy api:8000
}
